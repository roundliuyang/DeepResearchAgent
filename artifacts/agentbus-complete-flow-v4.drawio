        <mxCell id="lane3" value="" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=14;fillColor=#FAFBFC;strokeColor=#E0E5EB;align=left;verticalAlign=middle;strokeWidth=1;">
          <mxGeometry x="1095" y="185" width="470" height="1235" as="geometry" />
