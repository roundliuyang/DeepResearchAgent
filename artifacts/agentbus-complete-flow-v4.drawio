          <mxGeometry height="70" width="350" x="1794" y="845" as="geometry" />
        </mxCell>
        <mxCell id="action-check" parent="1" style="rhombus;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=#263548;spacing=7;fillColor=#E6F4F2;strokeColor=#5E9E98;align=center;verticalAlign=middle;strokeWidth=1.5;" value="16c  当前 Step&#10;还有未执行的 Action？" vertex="1">
          <mxGeometry height="90" width="330" x="2354" y="835" as="geometry" />
        </mxCell>
        <mxCell id="action-run" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=#263548;spacing=7;fillColor=#E6F4F2;strokeColor=#5E9E98;align=center;verticalAlign=middle;strokeWidth=1.5;" value="16d  for i, action in enumerate(actions)&#10;打印 Action i/N；解析 type / name / args&#10;skill → await scp；其他 → await tcp" vertex="1">
          <mxGeometry height="75" width="350" x="2344" y="955" as="geometry" />
        </mxCell>
        <mxCell id="action-done" parent="1" style="rhombus;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=#263548;spacing=7;fillColor=#E6F4F2;strokeColor=#5E9E98;align=center;verticalAlign=middle;strokeWidth=1.5;" value="工具名是 done？&#10;执行工具后检查" vertex="1">
          <mxGeometry height="85" width="330" x="2354" y="1055" as="geometry" />
        </mxCell>
        <mxCell id="action-next" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=#263548;spacing=7;fillColor=#E6F4F2;strokeColor=#5E9E98;align=center;verticalAlign=middle;strokeWidth=1.5;" value="否：记录本次动作结果，继续下一项&#10;Action 1/3 → 2/3 → 3/3&#10;此处不重新调用决策模型" vertex="1">
          <mxGeometry height="70" width="350" x="2344" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="step-record" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=#263548;spacing=7;fillColor=#E6F4F2;strokeColor=#5E9E98;align=center;verticalAlign=middle;strokeWidth=1.5;" value="16e  结束本批 actions&#10;可选记录 TOOL_STEP 记忆事件&#10;_think_and_tool 返回 done / result / reasoning" vertex="1">
          <mxGeometry height="75" width="350" x="1794" y="1155" as="geometry" />
        </mxCell>
        <mxCell id="step-post" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=#263548;spacing=7;fillColor=#E6F4F2;strokeColor=#5E9E98;align=center;verticalAlign=middle;strokeWidth=1.5;" value="16f  回到 __call__：step_number += 1&#10;保存本 Step 的 tracer&#10;_get_messages() 重建后续模型上下文" vertex="1">
          <mxGeometry height="70" width="350" x="1794" y="1255" as="geometry" />
        </mxCell>
        <mxCell id="step-check" parent="1" style="rhombus;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=#263548;spacing=7;fillColor=#E6F4F2;strokeColor=#5E9E98;align=center;verticalAlign=middle;strokeWidth=1.5;" value="response.done 为真？" vertex="1">
          <mxGeometry height="75" width="330" x="1804" y="1355" as="geometry" />
        </mxCell>
        <mxCell id="step-limit" parent="1" style="rhombus;whiteSpace=wrap;html=0;fontSize=13;fontFamily=Helvetica;fontColor=#263548;spacing=7;fillColor=#E6F4F2;strokeColor=#5E9E98;align=center;verticalAlign=middle;strokeWidth=1.5;" value="还有 Step 额度？&#10;step_number &lt; max_steps" vertex="1">
          <mxGeometry height="75" width="330" x="2354" y="1355" as="geometry" />
        </mxCell>
        <mxCell id="step-legend" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontSize=14;fontFamily=Helvetica;fontColor=#263548;spacing=10;fillColor=#F5F6F8;strokeColor=#C0C7D0;align=center;verticalAlign=middle;strokeWidth=1.5;" value="四层计数，互不混用&#10;&#10;规划 Round：Bus 调用 Planner 做一次整体决策；可分派多个子任务，也可直接确认完成。&#10;子任务展示编号 step-N-agent：每个规划分派项一个 todo；跨轮累计，编号不表示执行先后。&#10;执行 Step i/max_steps：单次 Agent 调用内的决策与执行循环；每次调用重新从 1 开始。&#10;动作 Action j/N：当前执行 Step 返回的第 j 个动作，N 是这批动作的数量。&#10;&#10;例：同轮并发分派 step-1 和 step-2，它们各自都从执行 Step 1 开始。&#10;每个执行 Step 内按顺序执行 Actions；遇到 done 跳过剩余动作，保存记录后退出执行循环。" vertex="1">
          <mxGeometry height="230" width="1090" x="1794" y="1640" as="geometry" />
        </mxCell>
        <mxCell id="step-to-model" edge="1" parent="1" source="q" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#697B8B;strokeWidth=1.5;fontColor=#697B8B;fontSize=12;labelBackgroundColor=#FFFFFF;fontStyle=0;" target="step-model" value="">
