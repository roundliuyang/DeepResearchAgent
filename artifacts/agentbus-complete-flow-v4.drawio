        </mxCell>
        <mxCell id="h" value="创建 Future&#10;_pending_responses[correlation_id] = future" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E8F0FC;strokeColor=#6D8FC4;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="830" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="i" value="task.mark_running()&#10;await queue.put(msg)；记录 message_enqueued" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E8F0FC;strokeColor=#6D8FC4;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="930" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="j" value="response = await future&#10;当前协程挂起，让出执行权" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E8F0FC;strokeColor=#6D8FC4;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="1030" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="k" value="worker while True&#10;message = await queue.get()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E8F0FC;strokeColor=#6D8FC4;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="845" y="730" width="310" height="70" as="geometry" />
