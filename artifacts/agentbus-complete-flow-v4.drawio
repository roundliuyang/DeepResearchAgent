          <mxGeometry x="65" y="1330" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="o" value="asyncio.gather(return_exceptions=True)&#10;并发 _call_agent(name, message, ctx)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E8F0FC;strokeColor=#6D8FC4;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="1430" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="q" value="每项：acp(name=子 Agent, ...)&#10;同一套 ACP / ContextManager 路由" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF0F5;strokeColor=#7C91A5;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="455" y="1430" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r" value="执行对应子 Agent.__call__()&#10;当前主要为 ToolCallingAgent&#10;详情见第 04 页" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E6F4F2;strokeColor=#5E9E98;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="845" y="1430" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s" value="_call_agent 封装执行结果&#10;正常：RESPONSE，含 success/result/error&#10;Exception：ERROR" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E8F0FC;strokeColor=#6D8FC4;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="1530" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="t" value="gather 等待全部结束，逐项配对&#10;round_results 以 dispatch_id 为键&#10;保留各项结果并追加历史摘要" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E8F0FC;strokeColor=#6D8FC4;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="1630" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="u" value="未完成且仍有轮次 → 下一轮&#10;失败结果也交给 Planner 决定下一步" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E8F0FC;strokeColor=#6D8FC4;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
