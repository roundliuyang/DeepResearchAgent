        <mxCell id="lane3head" value="ROUND 2 / 10｜PlanningAgent" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=18;fontFamily=Helvetica;spacing=14;fillColor=#F0EBFA;strokeColor=#9980C4;align=center;verticalAlign=middle;fontStyle=1;strokeWidth=1.5;">
          <mxGeometry x="1110" y="200" width="440" height="55" as="geometry" />
        </mxCell>
        <mxCell id="r1input" value="Bus → _call_planner_raw → ACP&#10;原始任务 + 可用 Agent；执行历史为空" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=14;fillColor=#F5F6F8;strokeColor=#C0C7D0;align=left;verticalAlign=middle;strokeWidth=1.5;">
          <mxGeometry x="55" y="285" width="430" height="85" as="geometry" />
        </mxCell>
        <mxCell id="r1json" value="PlanningAgent 返回关键字段&#10;&#10;{&#10;  &quot;analysis&quot;: &quot;&quot;,&#10;  &quot;plan_update&quot;: &quot;分派 tool_calling 智能体执行 hello world 技能。&quot;,&#10;  &quot;is_done&quot;: false,&#10;  &quot;dispatches&quot;: [&#10;    {&#10;      &quot;agent_name&quot;: &quot;tool_calling&quot;,&#10;      &quot;files&quot;: [],&#10;      &quot;task&quot;: &quot;执行 hello world 技能，返回问候语。&quot;&#10;    }&#10;  ],&#10;  &quot;final_result&quot;: &quot;&quot;&#10;}" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=14;fontFamily=monospace;spacing=14;fillColor=#F0EBFA;strokeColor=#9980C4;align=left;verticalAlign=top;strokeWidth=1.5;">
          <mxGeometry x="55" y="410" width="430" height="480" as="geometry" />
        </mxCell>
        <mxCell id="r1branch" value="AgentBus 按顺序判断&#10;&#10;① is_done=False → 跳过完成分支&#10;② 为分派项生成 ID，再校验 Agent&#10;③ 进入子任务执行分支" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=14;fillColor=#E8F0FC;strokeColor=#6D8FC4;align=left;verticalAlign=middle;strokeWidth=1.5;">
          <mxGeometry x="55" y="955" width="430" height="175" as="geometry" />
        </mxCell>
        <mxCell id="exec" value="AgentBus：_call_agent(...)&#10;→ acp(name=&quot;tool_calling&quot;)&#10;→ ToolCallingAgent.__call__()" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=14;fillColor=#F5F6F8;strokeColor=#C0C7D0;align=left;verticalAlign=middle;strokeWidth=1.5;">
          <mxGeometry x="585" y="955" width="430" height="175" as="geometry" />
        </mxCell>
        <mxCell id="actual" value="tool_calling 执行 hello world 技能&#10;取得问候语 → 调用 done&#10;记忆 / tracer 收尾 → 返回 AgentResponse" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=14;fillColor=#E6F4F2;strokeColor=#5E9E98;align=left;verticalAlign=middle;strokeWidth=1.5;">
          <mxGeometry x="585" y="745" width="430" height="135" as="geometry" />
        </mxCell>
        <mxCell id="collect" value="AgentBus：本轮全部执行结束&#10;&#10;按 dispatch_id 保存 success / result / error&#10;更新 round_results + execution_history&#10;当前仍不能据此直接结束顶层任务" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=14;fillColor=#E8F0FC;strokeColor=#6D8FC4;align=left;verticalAlign=middle;strokeWidth=1.5;">
          <mxGeometry x="585" y="505" width="430" height="175" as="geometry" />
        </mxCell>
        <mxCell id="next" value="_run_planner_loop：进入第 2 轮&#10;再次 _call_planner_raw(...)&#10;历史摘要 + 完整最新结果传给模型" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=14;fillColor=#E8F0FC;strokeColor=#6D8FC4;align=left;verticalAlign=middle;fontStyle=1;strokeWidth=1.5;">
          <mxGeometry x="585" y="285" width="430" height="135" as="geometry" />
        </mxCell>
        <mxCell id="r2input" value="Planner 读取上一轮结果&#10;评价结果，确认原始任务已完成" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=14;fillColor=#F0EBFA;strokeColor=#9980C4;align=left;verticalAlign=middle;strokeWidth=1.5;">
          <mxGeometry x="1115" y="285" width="430" height="85" as="geometry" />
        </mxCell>
        <mxCell id="r2json" value="PlanningAgent 返回关键字段&#10;&#10;{&#10;  &quot;analysis&quot;: &quot;上一轮执行成功，返回了有效的问候语。&quot;,&#10;  &quot;plan_update&quot;: &quot;All sub-tasks completed.&quot;,&#10;  &quot;is_done&quot;: true,&#10;  &quot;dispatches&quot;: [],&#10;  &quot;final_result&quot;: &quot;技能执行成功：Hey there, World! 👋 Welcome aboard!&quot;&#10;}" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=14;fontFamily=monospace;spacing=14;fillColor=#F0EBFA;strokeColor=#9980C4;align=left;verticalAlign=top;strokeWidth=1.5;">
          <mxGeometry x="1115" y="410" width="430" height="370" as="geometry" />
        </mxCell>
        <mxCell id="r2branch" value="AgentBus 首先判断 is_done=True&#10;&#10;进入完成分支，构造 RESPONSE：&#10;success=True&#10;result=final_result or plan_update&#10;&#10;不再检查空 dispatches，也不再派发。" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=14;fillColor=#E8F0FC;strokeColor=#6D8FC4;align=left;verticalAlign=middle;strokeWidth=1.5;">
          <mxGeometry x="1115" y="845" width="430" height="225" as="geometry" />
        </mxCell>
        <mxCell id="finish" value="_resolve_future → 唤醒 submit&#10;_run_planner_loop return，结束循环&#10;submit 标记 DONE 并返回结果" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=14;fillColor=#E8F0FC;strokeColor=#6D8FC4;align=left;verticalAlign=middle;fontStyle=1;strokeWidth=1.5;">
          <mxGeometry x="1115" y="1140" width="430" height="120" as="geometry" />
        </mxCell>
        <mxCell id="no3" value="不会进入第 3 轮&#10;不会触发“未完成且无分派”的错误" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=14;fillColor=#E8F0FC;strokeColor=#6D8FC4;align=center;verticalAlign=middle;strokeWidth=1.5;">
          <mxGeometry x="1115" y="1310" width="430" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="两个完成标记的区别&#10;&#10;tool_calling 的 done：该子任务完成。&#10;planning 的 is_done：整个原始任务完成。&#10;&#10;第 1 轮完成执行后，仍需第 2 轮规划确认。" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=17;fontFamily=Helvetica;spacing=14;fillColor=#F5F6F8;strokeColor=#C0C7D0;align=left;verticalAlign=middle;strokeWidth=1.5;">
          <mxGeometry x="55" y="1200" width="960" height="190" as="geometry" />
        </mxCell>
