          <mxGeometry x="455" y="430" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e" value="asyncio.create_task(_session_worker)&#10;保存 worker 句柄" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E8F0FC;strokeColor=#6D8FC4;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="455" y="530" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f" value="已有则复用；释放锁并返回" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E8F0FC;strokeColor=#6D8FC4;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
