        <mxCell id="edge27" value="普通终止后退出" edge="1" parent="1" source="x" target="y" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#697B8B;fontColor=#697B8B;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=1.5;fontStyle=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="220" y="2010" />
              <mxPoint x="220" y="2020" />
              <mxPoint x="610" y="2020" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="loop-boundary" value="" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=14;fillColor=none;strokeColor=#D59A26;align=left;verticalAlign=middle;strokeWidth=3;dashed=1;dashPattern=8 5;pointerEvents=0;">
          <mxGeometry x="30" y="415" width="1160" height="1400" as="geometry" />
        </mxCell>
        <mxCell id="loop-explanation" value="核心循环｜_run_planner_loop&#10;&#10;for round_num in range(1, max_rounds + 1)&#10;&#10;① 调用 Planner，取得本轮决策&#10;② is_done？完成则交付结果并 return&#10;③ 未完成：校验并分派子任务&#10;④ 等待本轮全部结果，更新历史&#10;⑤ 进入下一轮，再调用 Planner&#10;&#10;金色虚线框：每轮处理及其跨组件调用。&#10;金色粗回线：携带结果返回下一轮。&#10;&#10;Planner.__call__ 每次只做一轮决策；&#10;多轮循环由 AgentBus 驱动。" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=16;fontFamily=Helvetica;spacing=14;fillColor=#F5F6F8;strokeColor=#C0C7D0;align=left;verticalAlign=middle;strokeWidth=1.5;">
          <mxGeometry x="1260" y="415" width="390" height="510" as="geometry" />
        </mxCell>
        <mxCell id="loop-example-link" value="两轮规划示例 → 第 06 页&#10;&#10;第 1 轮：分派 1 个子任务 → step-1&#10;第 2 轮：确认完成，不再分派&#10;&#10;共 2 个规划 Round，只有 1 个 todo。&#10;点击此框跳转到示例页。" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=16;fontFamily=Helvetica;spacing=14;fillColor=#F5F6F8;strokeColor=#C0C7D0;align=left;verticalAlign=middle;strokeWidth=1.5;" link="data:page/id,planning-example">
          <mxGeometry x="1260" y="965" width="390" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
