        <mxCell id="l" value="决策分流&#10;is_done → 最终 RESPONSE&#10;None / 未完成却无分派 → ERROR" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E8F0FC;strokeColor=#6D8FC4;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="1130" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m" value="按任务 ID / 轮次 / 原始序号生成 ID&#10;再校验 dispatches.agent_name&#10;解析名称；跳过无效项，不重新编号" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E8F0FC;strokeColor=#6D8FC4;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
