  <diagram id="contracts" name="05｜数据契约、边界与代码索引">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1430" background="#FFFFFF" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="05｜数据契约、边界与代码索引" style="text;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#263548;fontSize=22;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="790" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="补充页用于核对数据字段和异常行为，不涉及程序启动或全局初始化。图中步骤对应本次读取的工作区代码。" style="text;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="790" height="45" as="geometry" />
        </mxCell>
        <mxCell id="bg0" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FAFBFC;strokeColor=#E0E5EB;fontColor=#243444;fontSize=14;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="35" y="130" width="370" height="1260" as="geometry" />
        </mxCell>
        <mxCell id="head0" value="数据在组件间怎样流动&#10;请求 → 决策 → 执行结果 → Future" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="45" y="140" width="350" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bg1" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FAFBFC;strokeColor=#E0E5EB;fontColor=#243444;fontSize=14;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="425" y="130" width="370" height="1260" as="geometry" />
        </mxCell>
        <mxCell id="head1" value="当前代码的分支语义&#10;按实现记录；不是理想化设计" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="435" y="140" width="350" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="TASK 消息：submit → session 队列&#10;session_id / task_id / correlation_id&#10;payload：content、files、max_rounds" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="230" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Planner 输入：Bus → ACP → PlanningAgent&#10;task、files、ctx；round_number、max_rounds&#10;agent_contract、execution_history、round_results" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="330" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="PlanDecision：PlanningAgent → Bus&#10;analysis、plan_update、dispatches&#10;is_done、final_result（另含决策依据字段）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="430" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="每项 dispatch：agent_name / task / files&#10;代码按任务 ID / 轮次 / 原始序号生成 ID&#10;PLAN 消息携带 dispatch_id / content / files" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="530" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="子 Agent → AgentResponse&#10;success / message / extra&#10;Bus 封装结果，并保留 dispatch_id" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="630" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="round_results：以 dispatch_id 为键&#10;保留 agent_name / task / success / result / error&#10;完整 JSON 通过 latest_round_results 传给模型" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="730" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="最终 BusMessage → _resolve_future&#10;correlation_id 对应 _pending_responses&#10;set_result 唤醒 submit；调用方读取 payload" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="830" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="AgentBus 源码索引&#10;submit:223；ensure:362；worker:393&#10;planner_loop:442；planner_raw:806&#10;call_agent:856；resolve_future:948" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="1030" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="Agent 源码索引&#10;ACPServer.__call__:283；ContextManager:1250&#10;PlanningAgent.__call__:571&#10;ToolCallingAgent.__call__:349；步骤循环:435" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="1230" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="无有效 decision / 未完成且无 dispatches&#10;Bus 立即交付 ERROR&#10;所有名称无效则进入下一轮，而非立即失败" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="455" y="230" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="Planner 模型调用失败的当前兜底&#10;生成 is_done=True，final_result 写错误&#10;Bus 因此仍发 success=True 的 RESPONSE" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="455" y="330" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="达到 max_rounds：先回传 ERROR&#10;再额外调用 Planner 做收尾&#10;收尾决策不执行，也不改写已交付结果" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="455" y="430" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="同轮多次调用同名 Agent：已修复&#10;各分派使用唯一 dispatch_id，不覆盖结果&#10;PlanRound / todos 按该 ID 匹配描述与结果" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="455" y="530" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="ToolCallingAgent 达到 max_steps&#10;即使最后一步刚 done，当前条件仍会&#10;将 response 覆盖成超限失败" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="455" y="630" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="done 后仍可能有记忆处理 / 模型调用&#10;end_session 与 tracer 保存结束后&#10;才返回 AgentResponse，Bus 才能收集" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="455" y="730" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b7" value="TTL 仅在开始处理顶层消息时检查&#10;不是整个任务执行的超时机制&#10;max_rounds 与 max_steps 是不同限制" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="455" y="830" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b8" value="当前配置 configs/bus.py&#10;注册 planning、tool_calling&#10;Planner 根据能力描述决定分派目标" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="455" y="1030" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b9" value="plan.md 是规划记录，不是调度入口&#10;执行由 Bus 消费结构化 decision 驱动&#10;Planner 本身不调用 Bus，也不分派子 Agent" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F5F6F8;strokeColor=#C0C7D0;fontColor=#263548;fontSize=13;fontFamily=Helvetica;spacing=9;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
