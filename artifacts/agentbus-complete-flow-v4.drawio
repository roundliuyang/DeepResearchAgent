  <diagram id="planning-example" name="06｜两轮规划示例 · 分派 → 执行 → 完成">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1510" background="#FFFFFF" connect="1" arrows="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="两轮规划示例｜一次执行子任务，两次调用 Planner" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=25;fontFamily=Helvetica;spacing=14;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;">
          <mxGeometry x="35" y="25" width="1530" height="60" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="说明性示例：沿用提供的 hello world 决策；不是本次运行日志。max_rounds=10 是上限，任务在第 2 轮完成即退出。" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=14;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;">
          <mxGeometry x="35" y="100" width="1530" height="55" as="geometry" />
        </mxCell>
        <mxCell id="lane1" value="" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=14;fillColor=#FAFBFC;strokeColor=#E0E5EB;align=left;verticalAlign=middle;strokeWidth=1;">
          <mxGeometry x="35" y="185" width="470" height="1235" as="geometry" />
        </mxCell>
        <mxCell id="lane1head" value="ROUND 1 / 10｜PlanningAgent" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=18;fontFamily=Helvetica;spacing=14;fillColor=#F0EBFA;strokeColor=#9980C4;align=center;verticalAlign=middle;fontStyle=1;strokeWidth=1.5;">
          <mxGeometry x="50" y="200" width="440" height="55" as="geometry" />
        </mxCell>
        <mxCell id="lane2" value="" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=14;fillColor=#FAFBFC;strokeColor=#E0E5EB;align=left;verticalAlign=middle;strokeWidth=1;">
          <mxGeometry x="565" y="185" width="470" height="1235" as="geometry" />
        </mxCell>
        <mxCell id="lane2head" value="执行与反馈｜AgentBus / tool_calling" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontColor=#263548;fontSize=18;fontFamily=Helvetica;spacing=14;fillColor=#F5F6F8;strokeColor=#C0C7D0;align=center;verticalAlign=middle;fontStyle=1;strokeWidth=1.5;">
